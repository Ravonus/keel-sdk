{
  "name": "oca-modern",
  "version": "0.3.0",
  "private": true,
  "description": "Keel/Keel protocol resurrection: browser-native artifacts, immutable chunk storage, revisioned viewers, and modular mint access.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "test:conformance": "KEEL_REQUIRE_SIBLINGS=1 node scripts/test.mjs",
    "check": "node scripts/check.mjs",
    "verify": "node scripts/verify.mjs",
    "mcp": "node packages/mcp/dist/cli.js",
    "mcp:self-test": "node packages/mcp/dist/cli.js --self-test",
    "contracts:static": "node scripts/solidity-static-check.mjs",
    "contracts:test": "forge test --root packages/contracts",
    "contracts:web3:test": "pnpm --filter @keel/web3-boundary-tests test",
    "contracts:gas:policy": "node scripts/solidity-gas-check.mjs",
    "contracts:gas:snapshot": "forge snapshot --root packages/contracts --match-path 'test/gas/*.t.sol' --snap packages/contracts/.gas-snapshot",
    "contracts:gas:check": "node scripts/solidity-gas-check.mjs && forge snapshot --root packages/contracts --match-path 'test/gas/*.t.sol' --check packages/contracts/.gas-snapshot",
    "contracts:gas:report": "forge test --root packages/contracts --gas-report",
    "contracts:size:check": "pnpm --dir packages/contracts size:check",
    "tezos:gas:policy": "pnpm --dir packages/tezos gas:policy",
    "tezos:gas:snapshot": "pnpm --dir packages/tezos gas:snapshot",
    "tezos:gas:check": "pnpm --dir packages/tezos gas:check",
    "tezos:gas:report": "pnpm --dir packages/tezos gas:report",
    "tezos:gas:octez": "pnpm --dir packages/tezos gas:octez",
    "tezos:gas:octez:snapshot": "pnpm --dir packages/tezos gas:octez:snapshot",
    "tezos:test:contracts": "pnpm --dir packages/tezos test:contracts",
    "demo": "pnpm --filter @keel/demo dev",
    "contracts:compile": "node scripts/compile-solidity.mjs",
    "contracts:compile:vault-runner": "node scripts/compile-vault-runner-solidity.mjs",
    "studio": "pnpm --filter @keel/studio dev",
    "studio:check": "pnpm --filter @keel/studio check",
    "studio:build": "pnpm --filter @keel/studio build",
    "studio:db:push": "pnpm --filter @keel/studio db:push",
    "studio:seed": "pnpm --filter @keel/studio db:seed",
    "studio:index": "pnpm --filter @keel/studio index",
    "db:push": "pnpm --filter @keel/studio db:push",
    "local:up": "docker compose up -d --wait postgres anvil",
    "local:down": "docker compose down",
    "local:deploy": "pnpm --filter @keel/studio contracts:deploy-local",
    "studio:deploy-seasonal-grove-local": "pnpm --filter @keel/studio contracts:deploy-seasonal-grove-local",
    "keel:local:e2e": "pnpm --filter @keel/ethereum-adapter build && node scripts/keel-factory-local-e2e.mjs",
    "local:setup": "pnpm local:up && pnpm studio:db:migrate && pnpm contracts:compile && pnpm local:deploy && pnpm studio:seed",
    "studio:dev": "pnpm --filter @keel/studio dev",
    "studio:deploy-local": "pnpm contracts:compile && pnpm --filter @keel/studio contracts:deploy-local",
    "studio:db:migrate": "pnpm --filter @keel/studio db:migrate",
    "studio:test:e2e": "pnpm --filter @keel/studio test:e2e",
    "studio:seed-demos": "pnpm --filter @keel/studio seed:demos",
    "studio:seed-seasonal-grove": "pnpm --filter @keel/studio contracts:seed-seasonal-grove",
    "studio:probe-reads": "pnpm --filter @keel/studio probe:read-stack",
    "demos:build": "node examples/demos/build.mjs",
    "reader-asset:compile": "pnpm --filter @keel/viewer build && node scripts/compile-reader-asset.mjs",
    "reader-asset:grid": "pnpm --filter @keel/viewer build && node scripts/build-directional-grid.mjs",
    "character-metadata:codec": "pnpm --filter @keel/viewer build && node scripts/character-metadata-codec.mjs",
    "keel-market:wallet:build": "node scripts/build-keel-market-wallet.mjs",
    "keel": "node tools/keel/cli.mjs",
    "keel:check": "node tools/keel/check.mjs",
    "keel:sync": "node tools/keel/cli.mjs sync",
    "keel:split": "node tools/keel/cli.mjs split --all",
    "keel:verify": "node tools/keel/cli.mjs verify --all",
    "keel:adopt": "node tools/keel/adopt.mjs",
    "keel:reconcile": "node tools/keel/cli.mjs reconcile",
    "keel:repos": "node tools/keel/cli.mjs repos",
    "keel:list": "node tools/keel/cli.mjs list",
    "sdk:gauntlet:audit": "node scripts/validate-sdk-gauntlet.mjs",
    "sdk:gauntlet:test": "node --test tests/sdk-gauntlet-validator.test.mjs",
    "sdk:gauntlet:snapshot:verify": "node scripts/capture-sdk-gauntlet-snapshot.mjs --verify",
    "vault:gauntlet:audit": "node scripts/validate-vault-gauntlet.mjs",
    "vault:gauntlet:release": "node scripts/validate-vault-gauntlet.mjs --release",
    "vault:testnets:verify": "node scripts/verify-vault-public-testnets.mjs",
    "vault:referee:benchmark": "pnpm --filter @keel/vault-referee benchmark",
    "trusted-runtime:benchmark": "node scripts/benchmark-trusted-runtime.mjs",
    "trusted-runtime:module-registry:sepolia": "node scripts/deploy-module-review-registry-sepolia.mjs",
    "trusted-runtime:module-registry:verify-sepolia": "node scripts/verify-module-registry-sepolia.mjs",
    "trusted-runtime:module-registry:deprecate-sepolia": "node scripts/module-registry-deprecate-sepolia.mjs",
    "vault:ord:regtest": "pnpm --filter @keel/protocol build && node scripts/verify-vault-ord-regtest.mjs",
    "vault:weapon-manifest": "node scripts/update-vault-weapon-generation-manifest.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "^22.15.0",
    "@wagmi/connectors": "8.1.0",
    "@wagmi/core": "3.6.4",
    "esbuild": "0.28.2",
    "solc": "0.8.36",
    "typescript": "^5.9.0",
    "viem": "^2.55.0",
    "@keel/protocol": "workspace:*",
    "@keel/sdk": "workspace:*",
    "@keel/mcp": "workspace:*",
    "@keel/viewer": "workspace:*",
    "@keel/builder": "workspace:*",
    "@keel/ethereum-adapter": "workspace:*",
    "@keel/sandbox-sdk": "workspace:*",
    "@keel/studio-core": "workspace:*",
    "@keel/sprite-codex": "workspace:*"
  },
  "packageManager": "pnpm@10.15.0"
}
