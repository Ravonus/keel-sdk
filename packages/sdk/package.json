{
  "name": "@keel/sdk",
  "version": "0.3.0",
  "description": "Typed campaign builders, EIP-712 payloads, ABIs, and signer-policy helpers for Keel contracts.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./abi": {
      "types": "./dist/abi.d.ts",
      "import": "./dist/abi.js"
    },
    "./module": {
      "types": "./dist/module/index.d.ts",
      "import": "./dist/module/index.js"
    },
    "./managed-publication": {
      "types": "./dist/managed-publication.d.ts",
      "import": "./dist/managed-publication.js"
    },
    "./three-scene-publication": {
      "types": "./dist/three-scene-publication.d.ts",
      "import": "./dist/three-scene-publication.js"
    },
    "./studio-upload": {
      "types": "./dist/studio-upload.d.ts",
      "import": "./dist/studio-upload.js"
    },
    "./studio-publication": {
      "types": "./dist/studio-publication.d.ts",
      "import": "./dist/studio-publication.js"
    },
    "./wake-uri": {
      "types": "./dist/wake-uri.d.ts",
      "import": "./dist/wake-uri.js"
    },
    "./fray-auction-intent": {
      "types": "./dist/fray-auction-intent.d.ts",
      "import": "./dist/fray-auction-intent.js"
    },
    "./studio-capabilities": {
      "types": "./dist/studio-capabilities.d.ts",
      "import": "./dist/studio-capabilities.js"
    },
    "./studio-agent-drafts": {
      "types": "./dist/studio-agent-drafts.d.ts",
      "import": "./dist/studio-agent-drafts.js"
    },
    "./creator-collection-wallet": {
      "types": "./dist/creator-collection-wallet.d.ts",
      "import": "./dist/creator-collection-wallet.js"
    },
    "./verification-shell": {
      "types": "./dist/verification-shell.d.ts",
      "import": "./dist/verification-shell.js"
    },
    "./asset-display": {
      "types": "./dist/asset-display.d.ts",
      "import": "./dist/asset-display.js"
    },
    "./presentation": {
      "types": "./dist/presentation.d.ts",
      "import": "./dist/presentation.js"
    },
    "./inline-viewer-graph": {
      "types": "./dist/inline-viewer-graph.d.ts",
      "import": "./dist/inline-viewer-graph.js"
    },
    "./shell-registry": {
      "types": "./dist/shell-registry.d.ts",
      "import": "./dist/shell-registry.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@keel/protocol": "workspace:*",
    "esbuild": "0.28.2",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  }
}
