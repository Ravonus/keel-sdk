{
  "name": "@keel/studio-core",
  "version": "0.3.0",
  "description": "Strict server-side preparation, compression, manifest generation, and deployment estimation for Keel Studio.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@keel/builder": "workspace:*",
    "@keel/protocol": "workspace:*",
    "onchfs": "0.1.0",
    "sharp": "0.35.3"
  }
}
