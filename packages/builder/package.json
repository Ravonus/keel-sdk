{
  "name": "@keel/builder",
  "version": "0.3.0",
  "description": "CLI and build pipeline for wrapping, compressing, auditing, and chunk-planning browser-native artifacts.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@keel/protocol": "workspace:*",
    "@keel/sdk": "workspace:*",
    "esbuild": "0.28.2",
    "terser": "5.44.0",
    "typescript": "^5.9.0"
  },
  "optionalDependencies": {
    "sharp": "^0.34.4"
  },
  "bin": {
    "keel": "./dist/cli.js",
    "oca": "./dist/cli.js"
  }
